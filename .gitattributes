# Keep the working tree identical on every platform. core.autocrlf=true on
# Windows was rewriting files to CRLF at checkout, so the Windows CI job read a
# different byte sequence from the one the tests were written against.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.duckdb binary
*.db binary
*.parquet binary
